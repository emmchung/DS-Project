analyzer = SentimentIntensityAnalyzer()




def sentiment_to_rating(compound):
    rating = 1 + ((compound + 1) / 2) * 4
    return round(rating, 1)
def get_aspect_context(review, keywords):
    words = review.split()
    contexts = []

    for i in range(len(words)):

        for keyword in keywords:
            keyword_words = keyword.lower().split()


            if len(keyword_words) == 1:
                clean_word = re.sub(r'[^\w-]', '', words[i].lower())

                if clean_word == keyword_words[0]:


                    start = max(0, i - 3)
                    end = min(len(words), i + 4)

                    context = " ".join(words[start:end])
                    contexts.append(context)

                    break


            else:
                if i + len(keyword_words) <= len(words):

                    phrase_words = [
                        re.sub(r'[^\w-]', '', w.lower())
                        for w in words[i:i + len(keyword_words)]
                    ]

                    if phrase_words == keyword_words:

                        start = max(0, i - 3)
                        end = min(
                            len(words),
                            i + len(keyword_words) + 3
                        )

                        context = " ".join(words[start:end])
                        contexts.append(context)

                        break

    return contexts

def score_aspect(review, keywords):
    sentences = get_aspect_context(review, keywords)

    if not sentences:
        return None

    scores = []

    for sentence in sentences:
        compound = analyzer.polarity_scores(sentence)["compound"]
        scores.append(compound)

    average_score = sum(scores) / len(scores)

    return sentiment_to_rating(average_score)
test_reviews = [
    "The food was absolutely amazing but the prices were ridiculous.",
    "The food was terrible and completely inedible.",
    "The food was pretty good and the service was excellent.",
    "The food was okay but we waited forever.",
    "The food was cold but the service was fantastic."
]

for review in test_reviews:

    quality = score_aspect(review, quality_keywords)
    price = score_aspect(review, price_keywords)
    convenience = score_aspect(review, convenience_keywords)

    print("\nREVIEW:")
    print(review)

    print("Quality:", quality)
    print("Price:", price)
    print("Convenience:", convenience)

review = "The food was okay."

contexts = get_aspect_context(review, quality_keywords)

test_phrases = [
    "The food was pretty good",
    "The service was excellent",
    "The food was okay",
    "we waited forever",
    "The wait was terrible",
    "The wait was very long"
]

for phrase in test_phrases:
    compound = analyzer.polarity_scores(phrase)["compound"]
    rating = sentiment_to_rating(compound)

    print(phrase)
    print("VADER:", compound)
    print("Rating:", rating)
    print()

print("Contexts:", contexts)

for context in contexts:
    print("Context:", context)
    print("VADER:", analyzer.polarity_scores(context)["compound"])
    print("Rating:", sentiment_to_rating(analyzer.polarity_scores(context)["compound"]))
